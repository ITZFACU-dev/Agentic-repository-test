{
  "name": "cosmoscope",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cosmoscope — an educational 3D gravity & astrophysics sandbox (Universe Sandbox inspired) built on Three.js / WebGL2 with a Web Worker physics core.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@shaderfrog/glsl-parser": "^7.0.1",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
